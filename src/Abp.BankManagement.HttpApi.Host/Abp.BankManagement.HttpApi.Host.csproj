    <PackageReference Include="Volo.Abp" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.Autofac" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.EventBus.RabbitMq" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="9.2.3" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="9.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="4.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abp.BankManagement.Application\Abp.BankManagement.Application.csproj" />
